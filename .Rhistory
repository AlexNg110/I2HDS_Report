geom_text(aes(label = round(measure, 1)), vjust = -1, size = 3) +
theme_light() +
theme(axis.title.x = element_text(margin = margin(t = 10)),axis.title.y = element_text(margin = margin(r = 10)), plot.title = element_text(face = "bold", hjust = 0.5)) +
scale_x_continuous(breaks = 2014:2023, expand = expansion(mult = c(0.02, 0.1))) +
scale_y_continuous(breaks = 16:24, expand = expansion(mult = c(0.02, 0.1))) +
labs(
title = str_wrap("Population prescribed drugs for anxiety, depression and psychosis in Scotland between 2014 and 2023", width = 65),
x = "Year",
y = "Percentage"
)
